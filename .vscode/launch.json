{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run API (http)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/LibrarySystem.Api/bin/Debug/net9.0/LibrarySystem.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/LibrarySystem.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5044"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
